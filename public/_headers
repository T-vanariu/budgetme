# Cloudflare Pages headers. Replace <<PROJECT_REF>> with your Supabase project ref.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://<<PROJECT_REF>>.supabase.co; connect-src 'self' https://<<PROJECT_REF>>.supabase.co wss://<<PROJECT_REF>>.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(self), geolocation=(), microphone=()
