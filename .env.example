# Browser (.env.local) — publishable only. RLS protects the data.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<<your anon / publishable key>>

# Edge Function secrets — set with `supabase secrets set ...` (hosted)
# or put in supabase/.env.local for `supabase functions serve`. NEVER prefix with VITE_.
AI_API_KEY=<<Anthropic API key>>
AI_MODEL=claude-opus-5-5
AI_MONTHLY_CAP_USD=5
# US$ per million tokens, from the provider's pricing page (claude-opus-5-5: 4 in / 20 out)
AI_PRICE_INPUT_PER_MTOK=4
AI_PRICE_OUTPUT_PER_MTOK=20
SCAN_DAILY_LIMIT=30
AI_TIMEOUT_MS=20000
CONFIDENCE_FLOOR=0.6
